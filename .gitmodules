[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "lib/openzeppelin-contracts"]
	path = lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "lib/gmx-synthetics"]
	path = lib/gmx-synthetics
	url = https://github.com/gmx-io/gmx-synthetics
[submodule ".deps/npm/v4-core"]
	path = .deps/npm/v4-core
	url = https://github.com/Uniswap/v4-core
[submodule ".deps/npm/universal-router"]
	path = .deps/npm/universal-router
	url = https://github.com/Uniswap/universal-router
