		"devdoc": {
			"author": "@Diego-AVZ",
			"details": "Integrates with GMX V2 DataStore to fetch Chainlink price feed addresses",
			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"_addressProvider": "Address of the AddressProvider contract"
					}
				},
				"getAcceptablePrice(address,bool,bool,uint256)": {
					"details": "Logic based on GMX's BaseOrderUtils.sol:      - INCREASE LONG: acceptablePrice is MAX price you'll pay (current + slippage)      - INCREASE SHORT: acceptablePrice is MIN price you'll accept (current - slippage)      - DECREASE LONG: acceptablePrice is MIN price you'll accept (current - slippage)      - DECREASE SHORT: acceptablePrice is MAX price you'll pay (current + slippage) ",
					"params": {
						"isIncrease": "True for opening/increasing, false for closing/decreasing",
						"isLong": "True for long position, false for short",
						"marketAddress": "Address of the GMX market",
						"slippageBps": "Slippage tolerance in basis points (e.g., 50 = 0.5%)"
					},
					"returns": {
						"acceptablePrice": "Price in GMX format (30 decimals)",
						"currentPrice": "Current market price in GMX format (30 decimals)"
					}
				},
				"getAcceptablePriceDefault(address,bool,bool)": {
					"params": {
						"isIncrease": "True for opening/increasing, false for closing/decreasing",
						"isLong": "True for long position, false for short",
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"acceptablePrice": "Price in GMX format (30 decimals)",
						"currentPrice": "Current market price in GMX format (30 decimals)"
					}
				},
				"getChainlinkPriceFeed(address)": {
					"params": {
						"token": "Address of the token"
					},
					"returns": {
						"priceFeedAddress": "Address of the Chainlink price feed"
					}
				},
				"getMarketPriceFeeds(address)": {
					"params": {
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"indexTokenPriceFeed": "Price feed for index token",
						"longTokenPriceFeed": "Price feed for long collateral token",
						"shortTokenPriceFeed": "Price feed for short collateral token"
					}
				},
				"getMarketPriceWithDecimals(address)": {
					"params": {
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"decimals": "Decimals of the price",
						"price": "Current price of index token"
					}
				},
				"getMarketPrices(address)": {
					"params": {
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"indexTokenPrice": "Price of index token",
						"longTokenPrice": "Price of long collateral token",
						"shortTokenPrice": "Price of short collateral token"
					}
				},
				"getMarketPricesWithDecimals(address)": {
					"params": {
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"indexDecimals": "Decimals for index token price",
						"indexPrice": "Price of index token",
						"longDecimals": "Decimals for long token price",
						"longPrice": "Price of long token",
						"shortDecimals": "Decimals for short token price",
						"shortPrice": "Price of short token"
					}
				},
				"getMarketTokens(address)": {
					"params": {
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"indexToken": "Address of the index token (e.g., WETH for ETH/USD market)",
						"longToken": "Address of the long collateral token",
						"shortToken": "Address of the short collateral token"
					}
				},
				"getPrice(address)": {
					"params": {
						"marketAddress": "Address of the GMX market"
					},
					"returns": {
						"price": "Current price from Chainlink (8 decimals typically)"
					}
				},
				"toGMXPrice(uint256,uint8)": {
					"details": "GMX uses 30 decimals for all internal price calculations",
					"params": {
						"price": "Price from Chainlink (typically 8 decimals)",
						"priceDecimals": "Decimals of the input price"
					},
					"returns": {
						"gmxPrice": "Price in GMX format (30 decimals)"
					}
				}
			},
			"title": "GMX Prices",
			"version": 1
		},
