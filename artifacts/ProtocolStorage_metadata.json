			"methods": {
				"constructor": {
					"params": {
						"_roles": "Address of the Roles contract for protocol contract verification"
					}
				},
				"getProtocolStats()": {
					"returns": {
						"_0": "ProtocolStats struct containing all protocol metrics"
					}
				},
				"getUser(address)": {
					"params": {
						"_user": "The address of the user to query"
					},
					"returns": {
						"_0": "User struct containing all user data"
					}
				},
				"getUsersCount()": {
					"returns": {
						"_0": "Total number of users registered"
					}
				},
				"updateTotalActivePositions(int256)": {
					"custom:security": "Only protocol contracts can update active positions. Prevents underflow",
					"details": "Only callable by authorized protocol contracts. Handles both increases and decreases",
					"params": {
						"_change": "The change in active positions (positive or negative)"
					}
				},
				"updateTotalPnl(int256)": {
					"custom:security": "Only protocol contracts can update PnL. Prevents underflow",
					"details": "Only callable by authorized protocol contracts. Handles both positive and negative PnL",
					"params": {
						"_pnl": "The PnL change (positive or negative)"
					}
				},
				"updateTotalPositions()": {
					"custom:security": "Only protocol contracts can update positions count",
					"details": "Only callable by authorized protocol contracts"
				},
				"updateTotalTransactions()": {
					"custom:security": "Only protocol contracts can update transaction count",
					"details": "Only callable by authorized protocol contracts"
				},
				"updateTotalValueLocked(int256)": {
					"custom:security": "Only protocol contracts can update TVL. Prevents underflow",
					"details": "Only callable by authorized protocol contracts. Handles both increases and decreases",
					"params": {
						"_change": "The change in total value locked (positive or negative)"
					}
				},
				"updateTotalVolume(uint256)": {
					"custom:security": "Only protocol contracts can update volume",
					"details": "Only callable by authorized protocol contracts",
					"params": {
						"_amount": "The amount to add to total volume"
					}
				}
			},
