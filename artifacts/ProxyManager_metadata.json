		"devdoc": {
			"details": "This contract implements a proxy pool system to minimize gas costs by reusing proxy contracts.      Proxies are pooled when they become available (no active positions) and can be claimed by      new users. If no proxies are available, new ones are deployed through ProxyFactory.       Key features:      - Proxy deployment and registration      - Proxy pooling and availability management      - Batch-based proxy tracking for gas efficiency      - Owner management and access control       Flow:      1. User requests a proxy via initializeProxy()      2. System checks for available proxies in batches      3. If available: proxy is claimed and owner is set      4. If not available: new proxy is deployed      5. When position closes: proxy is marked as available for reuse",
			"errors": {
				"ReentrancyGuardReentrantCall()": [
					{
						"details": "Unauthorized reentrant call."
					}
				]
			},
			"events": {
				"ProxyClaimed(address,uint256)": {
					"params": {
						"proxyId": "The ID of the claimed proxy",
						"user": "Address of the user claiming the proxy"
					}
				},
				"ProxyDeployed(address,address,uint256)": {
					"params": {
						"owner": "Address of the owner assigned to the proxy",
						"proxy": "Address of the deployed proxy contract",
						"proxyId": "The unique ID assigned to the proxy"
					}
				}
			},
			"kind": "dev",
			"methods": {
				"constructor": {
					"params": {
						"_addressProvider": "Address of the AddressProvider contract"
					}
				},
				"getAvailableProxy()": {
					"details": "Searches through all batches (newest first) to find an available proxy.      Returns the last proxy in the first batch with available proxies (LIFO). Returns (0, 0, address(0), false) if no proxies are available,      indicating that initializeProxy should deploy a new one",
					"returns": {
						"_0": "proxyId ID of the available proxy (0 if none available)",
						"_1": "batchId ID of the batch containing the proxy (0 if none available)",
						"_2": "proxyAddress Address of the proxy contract (address(0) if none available)",
						"_3": "isAvailable true if a proxy is available, false if new proxy must be deployed "
					}
				},
				"getBatchAvailableCount(uint256)": {
					"params": {
						"_batchId": "ID of the batch to check"
					},
					"returns": {
						"_0": "The number of available proxies in the batch"
					}
				},
				"getOwner(uint256)": {
					"params": {
						"_proxyId": "ID of the proxy"
					},
					"returns": {
						"_0": "Address of the owner (address(0) if proxy is available)"
					}
				},
				"initializeProxy(address)": {
					"details": "Main entry point for obtaining a proxy. Checks for available proxies first,      and if none are available, deploys a new one. Implements reentrancy protection. Flow:      1. Calls getAvailableProxy() to check for available proxies      2. If available: claims it and sets owner      3. If not available: deploys new proxy via ProxyFactory",
					"params": {
						"_owner": "Address of the user who will own the proxy"
					},
					"returns": {
						"_proxyAddress": "Address of the proxy assigned to the user "
					}
				},
				"isbatchFilled(uint256)": {
					"details": "Used to determine if a new batch should be created",
					"params": {
						"_batchId": "ID of the batch to check"
					},
					"returns": {
						"_0": "true if the batch has reached MAX_BATCH_SIZE, false otherwise"
					}
				},
				"setAvailable(uint256)": {
					"custom:require": "Only callable by protocol contractsProxy must have an owner and be available (no active positions) ",
					"details": "Called by ClosePositionCallbacks when all positions are closed.      Adds proxy to an available batch (or creates new batch if all are full).      Sets owner to address(0) to mark as available. Batch logic:      - Searches for first non-full batch      - If found: adds proxy to that batch      - If all batches full: creates new batch with this proxy",
					"params": {
						"_proxyId": "ID of the proxy to mark as available "
					}
				}
			},
			"title": "ProxyManager",
			"version": 1
		},
		"userdoc": {
			"errors": {
				"InvalidProxyId()": [
					{
						"notice": "Thrown when proxy ID validation fails during batch operations"
					}
				],
				"ProxyHasPendingOrders()": [
					{
						"notice": "Thrown when attempting to perform an operation on a proxy with pending orders"
					}
				],
				"ProxyNotAvailable()": [
					{
						"notice": "Thrown when attempting to claim a proxy that is not available (already has an owner)"
					}
				],
				"SenderNotAllowed()": [
					{
						"notice": "Thrown when a function is called by an unauthorized address (not a protocol contract)"
					}
				]
			},
			"events": {
				"ProxyClaimed(address,uint256)": {
					"notice": "Emitted when a user claims an available proxy"
				},
				"ProxyDeployed(address,address,uint256)": {
					"notice": "Emitted when a new proxy is deployed"
				}
			},
			"kind": "user",
			"methods": {
				"MAX_BATCH_SIZE()": {
					"notice": "Maximum number of proxies per batch (for gas efficiency)"
				},
				"addressProvider()": {
					"notice": "Address provider that stores all protocol addresses"
				},
				"availableProxiesBatch(uint256)": {
					"notice": "Mapping from batch ID to Batch struct containing available proxies"
				},
				"batchId()": {
					"notice": "Current batch ID (increments as batches fill up)"
				},
				"constructor": {
					"notice": "Constructs the ProxyManager contract"
				},
				"getAvailableProxy()": {
					"notice": "Gets the first available proxy from any batch"
				},
				"getBatchAvailableCount(uint256)": {
					"notice": "Gets the available count of proxies in a batch"
				},
				"getOwner(uint256)": {
					"notice": "Gets the current owner of a proxy"
				},
				"initializeProxy(address)": {
					"notice": "Initializes a proxy for a user (deploys new or claims available)"
				},
				"isbatchFilled(uint256)": {
					"notice": "Checks if a batch is filled to capacity"
				},
				"proxies(uint256)": {
					"notice": "Mapping from proxy ID to Proxy struct"
				},
				"proxyCount()": {
					"notice": "Total number of proxies ever deployed (increments, never decreases)"
				},
				"roles()": {
					"notice": "Roles contract for access control verification"
				},
				"setAvailable(uint256)": {
					"notice": "Marks a proxy as available for reuse when it has no active positions"
				}
			},
			"notice": "Manages the lifecycle of PairTradingProxy instances for efficient resource usage",
			"version": 1
		}
