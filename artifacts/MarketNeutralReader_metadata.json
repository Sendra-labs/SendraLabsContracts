		"devdoc": {
			"details": "Provides functions to read position data from GMX and calculate real-time metrics",
			"kind": "dev",
			"methods": {
				"bothSidesExist(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"_bothSidesExist": "true if both long and short positions exist"
					}
				},
				"constructor": {
					"params": {
						"_addressProvider": "Address of the AddressProvider contract"
					}
				},
				"getMarketNeutralBasicInfo(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"longPosition": "Long position data from GMX",
						"shortPosition": "Short position data from GMX"
					}
				},
				"getMarketNeutralFullInfo(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"longInfo": "Complete info for long position",
						"shortInfo": "Complete info for short position",
						"totalFees": "Total fees (long + short)",
						"totalPnl": "Total PNL (long + short)"
					}
				},
				"getMarketNeutralMarkets(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"marketLong": "Long market address",
						"marketShort": "Short market address"
					}
				},
				"getMarketNeutralPosition(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"position": "ProtocolLib.Position struct",
						"positionIndex": "Index of the position in the array"
					}
				},
				"getMarketNeutralPositionKeys(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"longKey": "Long position key",
						"shortKey": "Short position key"
					}
				},
				"getMarketNeutralRealTimePnL(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"longPnl": "PNL of long position in USD (30 decimals)",
						"shortPnl": "PNL of short position in USD (30 decimals)",
						"totalPnl": "Total PNL (longPnl + shortPnl)"
					}
				},
				"getMarketNeutralTotalCollateral(address,uint256)": {
					"details": "Note: This returns raw amounts, not converted to USD",
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"totalCollateral": "Total collateral amount"
					}
				},
				"getMarketNeutralTotalSize(address,uint256)": {
					"params": {
						"positionId": "Position ID in ProtocolStorage",
						"user": "User address"
					},
					"returns": {
						"totalSize": "Total size in USD (long + short)"
					}
				},
				"getPositionCollateral(bytes32)": {
					"params": {
						"positionKey": "The position key"
					},
					"returns": {
						"collateralAmount": "Collateral amount in token decimals"
					}
				},
				"getPositionFees(bytes32,address)": {
					"params": {
						"market": "Market address",
						"positionKey": "The position key"
					},
					"returns": {
						"totalFees": "Total fees in collateral token"
					}
				},
				"getPositionFromGMX(bytes32)": {
					"details": "These are historical data stored when the position was opened/modified",
					"params": {
						"positionKey": "The position key (calculated with calculatePositionKey)"
					},
					"returns": {
						"position": "Struct with position data"
					}
				},
				"getPositionInfoFromGMX(bytes32,address)": {
					"details": "This function consumes more gas than getPositionFromGMX but provides real-time data",
					"params": {
						"market": "Market address",
						"positionKey": "The position key"
					},
					"returns": {
						"positionInfo": "Complete PositionInfo struct with PNL, fees, etc."
					}
				},
				"getPositionOpenTime(bytes32)": {
					"params": {
						"positionKey": "The position key"
					},
					"returns": {
						"timestamp": "Opening timestamp"
					}
				},
				"getPositionPnL(bytes32,address)": {
					"params": {
						"market": "Market address",
						"positionKey": "The position key"
					},
					"returns": {
						"pnl": "PNL in USD (30 decimals)"
					}
				},
				"getPositionSize(bytes32)": {
					"params": {
						"positionKey": "The position key"
					},
					"returns": {
						"sizeInUsd": "Position size in USD (30 decimals)"
					}
				},
				"isLongPosition(bytes32)": {
					"params": {
						"positionKey": "The position key"
					},
					"returns": {
						"isLong": "true if long position, false if short"
					}
				},
				"positionExistsInGMX(bytes32)": {
					"params": {
						"positionKey": "The position key"
					},
					"returns": {
						"exists": "true if position exists and has size > 0"
					}
				}
			},
